# Copy this file to ".env" and fill in your keys. Never commit .env.

# --- Dissertation ---
PDF=original.pdf
DOC_TITLE=Alcohol Consumption in the Context of Conflicting Societal and Personal Factors
DOC_AUTHOR=Mindaugas Sinkevičius
# Date the source dates are compared against (later sources cannot be plagiarism sources)
DOC_DATE=2015-07-21
# Words that identify the author's own works / copies of the dissertation
AUTHOR_MARKERS=Sinkevičius,Sinkevicius
# Pages to check (main text: from "Key definitions" to "Conclusions")
BODY_PAGES=10-174
WORK_DIR=work

# --- Stage 1: search ---
# A single engine or a chain (when one runs out of credits, the next one is used automatically):
#   serper     – Google results; 2,500 free queries on sign-up (no card). This dissertation needs ~2,070.
#   tavily     – 1,000 free queries per month (no card)
#   ddg        – free, no key (pip install ddgs); slower and less precise than Google
#   serpapi | brave | google_cse – paid alternatives
SEARCH_BACKEND=serper,tavily,ddg
SERPER_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Maximum number of new queries per run (a safeguard against exceeding free credits). 0 = unlimited.
SEARCH_BUDGET=2400
# loose = without quotes (also finds lightly rewritten sentences) | exact = exact phrase | both = both (2x cost)
QUERY_MODE=loose
SEARCH_WORKERS=6

# --- Stage 1: downloading sources ---
MAX_SOURCES=900
# E-mail for the Unpaywall / OpenAlex / Crossref APIs (free; helps find open-access PDFs) – recommended
UNPAYWALL_EMAIL=
USE_WAYBACK=1
# Folder where you can put PDF/TXT files of suspected sources (e.g. paywalled articles) – they are always compared
LOCAL_SOURCES=local_sources
# List of URLs that are always checked (here: sources found by an earlier tool)
SEEDS_FILE=seeds_from_example.txt
# Manually verified source metadata (authors, dates)
OVERRIDES_FILE=source_overrides.json

# --- Stage 2: LLM ---
# anthropic | openai | none (none = no LLM, heuristic labels only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# A stronger model can be used for the final conclusion, e.g. claude-opus-5-5
LLM_FINAL_MODEL=
LLM_WORKERS=4
LLM_MAX_PAIRS=40
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
